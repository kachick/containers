# You can get these digest by using:
# podman manifest inspect public.ecr.aws/docker/library/buildpack-deps:26.04-scm | jq -r '.manifests[0].digest'
FROM public.ecr.aws/docker/library/buildpack-deps:26.04-scm@sha256:94fb43e4b298af21cdecc40f1f1bb41d9ac13606eaedce7009c889ff43912aa9

LABEL org.opencontainers.image.source=https://github.com/kachick/containers
LABEL org.opencontainers.image.description="Nix package manager on Ubuntu - systemd"
LABEL org.opencontainers.image.licenses=MIT

# Available versions in apt: https://packages.ubuntu.com/noble/curl
# --no-install-recommends omits ca-certificates
RUN apt-get update \
 && apt-get install --no-install-recommends -y systemd \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

ENV PATH="${PATH}:/nix/var/nix/profiles/default/bin"

# AFAIK, we can not use original installer for this purpose because it does not have options similar to `--no-start-daemon`
# Instead, https://github.com/NixOS/nix-installer is now an official and modernized beta installer.
#
# * accept-flake-config: Potentially insecure setting, but reasonable for this container image
RUN curl --proto '=https' --tlsv1.2 -sSf -L https://artifacts.nixos.org/nix-installer | sh -s -- install linux --enable-flakes \
  --extra-conf "sandbox = false" \
  --extra-conf "trusted-users = root user" \
  --extra-conf "extra-substituters = https://cache.kachick.dev https://kachick.cachix.org" \
  --extra-conf "extra-trusted-substituters = https://nix-community.cachix.org https://cache.numtide.com" \
  --extra-conf "extra-trusted-public-keys = cache.kachick.dev-1:qxT+mjqH5A1VvQ/piD14E7heonmzkIPvati+dndwYFY= kachick.cachix.org-1:7giZGKW03gPFkbde09JNpDKCbDGGwBuU/Z11W/jUtEQ= nix-community.cachix.org-1:mB9FSh9qf2dCimDSUo8Zy7bkq5CX+/rkCWyvRCYg3Fs= niks3.numtide.com-1:DTx8wZduET09hRmMtKdQDxNNthLQETkc/yaX7M4qK0g=" \
  --extra-conf "accept-flake-config = true" \
  --no-start-daemon \
  --no-confirm

# TODO: Consider to extract from this repository
ARG username="user"
RUN useradd --no-log-init --create-home $username

CMD ["/usr/lib/systemd/systemd", "--system"]
