{
  "json": {},
  "markdown": {},
  "yaml": { "quotes": "preferSingle" },
  "dockerfile": {
    "associations": [
      "Containerfile"
    ]
  },
  "excludes": [
    "**/target/**",
    "**/*.lock"
  ],
  "plugins": [
    "https://plugins.dprint.dev/json-0.25.1.wasm",
    "https://plugins.dprint.dev/markdown-0.26.0.wasm",
    "https://plugins.dprint.dev/g-plane/pretty_yaml-v0.6.0.wasm",
    "https://plugins.dprint.dev/dockerfile-0.7.0.wasm"
  ]
}
