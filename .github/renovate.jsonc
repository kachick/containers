{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>kachick/renovate-config//presets/default.jsonc",
    "github>kachick/renovate-config//presets/cargo.jsonc"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "dockerfile"
      ],
      // Only bump digest
      // https://github.com/renovatebot/renovate/discussions/14883
      // https://github.com/kachick/containers/pull/292#issuecomment-3873277895
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
