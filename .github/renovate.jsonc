{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>kachick/renovate-config//presets/default.jsonc",
    "github>kachick/renovate-config//presets/cargo.jsonc"
  ],
  "nix": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep channel-tracking flake inputs fixed to current release series",
      "matchManagers": [
        "nix"
      ],
      "matchPackageNames": [
        "nixpkgs"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      // Only bump digest
      // https://github.com/renovatebot/renovate/discussions/14883
      // https://github.com/kachick/containers/pull/292#issuecomment-3873277895
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "enabled": false
    }
  ]
}
